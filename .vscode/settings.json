{
  // ---------------------------------------------------------------------------
  // clangd
  //
  // CMake 已在所有预设中开启 CMAKE_EXPORT_COMPILE_COMMANDS，编译数据库位于
  //   <preset> = windows-clang | windows-clang-release | windows-msvc
  // 生成一次即可：cmake --preset windows-clang
  //
  // 若在 WSL 里用 VS Code Remote 打开同一仓库，把下面的目录改成
  //   ${workspaceFolder}/build/linux-clang
  // ---------------------------------------------------------------------------
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/windows-clang",
    "--background-index",
    "--background-index-priority=normal",
    "--pch-storage=memory",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--all-scopes-completion",
    "--clang-tidy=false"
  ],

  // 构建前不存在 compile_commands.json 时，clangd 会退化为猜测标志；
  // 关掉自动更新检查，避免每次启动联网询问。
  "clangd.checkUpdates": false,

  // 关掉 MS C/C++ 插件的 IntelliSense，避免与 clangd 抢符号、重复报错。
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.codeAnalysis.runAutomatically": false,

  // ---------------------------------------------------------------------------
  // CMake Tools：与 CMakePresets.json 对齐
  // ---------------------------------------------------------------------------
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,

  // ---------------------------------------------------------------------------
  // 终端验证：默认在独立窗口里跑，而不是 VS Code 集成终端
  // ---------------------------------------------------------------------------
  // F5 与 CMake Tools 的调试按钮都走这份默认配置（见 launch.json 注释）。
  "cmake.debugConfig": {
    "externalConsole": true
  },

  // externalTerminal 使用的外部终端程序。wt.exe 依赖 App Execution Alias 在
  // PATH 中（默认开启）；找不到时改成完整路径：
  //   C:\\Users\\<user>\\AppData\\Local\\Microsoft\\WindowsApps\\wt.exe
  "terminal.external.windowsExec": "wt.exe",

  // externalConsole 窗口的尺寸 VS Code 管不到。若它落在 conhost 上，可用
  // Windows 控制台默认值把它固定成 80x25（(25<<16)|80 = 0x00190050）：
  //   reg add HKCU\Console /v WindowSize       /t REG_DWORD /d 0x00190050 /f
  //   reg add HKCU\Console /v ScreenBufferSize /t REG_DWORD /d 0x00190050 /f
  // 需要精确控制时请改用 tasks.json 的 "run: demo (Windows Terminal 80x25)"。

  // ---------------------------------------------------------------------------
  // 编辑
  // ---------------------------------------------------------------------------
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[c]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[cpp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
