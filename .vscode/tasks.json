{
  // ---------------------------------------------------------------------------
  // 在独立窗口里验证终端行为
  //
  // CMake Tools 的 ▶ (launch) 总是在 VS Code 集成终端里跑：那是一层 conpty +
  // VS Code 自己的 ANSI 解析器，alt screen、鼠标、Kitty 键盘协议与同步更新的
  // 表现和真实终端并不完全一致。
  //
  //   * 肉眼验证真实终端 -> "run: hello (Windows Terminal 80x25)"
  //     (Terminal > Run Task / Ctrl+Shift+B)，由 wt.exe 弹出独立 80x25 窗口；
  //   * 断点调试         -> F5，launch.json 用 externalConsole 走独立窗口。
  //
  // 第一次运行前先执行 "CMake: Select Configure Preset"（windows-clang）。
  // ---------------------------------------------------------------------------
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "cmake",
      "command": "configure",
      "preset": "${command:cmake.activeConfigurePresetName}",
      "problemMatcher": []
    },
    {
      "label": "build: hello",
      "type": "cmake",
      "command": "build",
      "targets": ["termcore_hello"],
      "preset": "${command:cmake.activeConfigurePresetName}",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "dependsOn": ["CMake: configure"]
    },
    {
      "label": "run: hello (Windows Terminal 80x25)",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Microsoft\\WindowsApps\\wt.exe",
      // wt 全局选项：--size 列,行（字符数）、--pos x,y（像素）。
      //   想每次强制开新窗口而不是复用最近窗口，追加 "-w", "new"。
      // cmd /k + pause 让窗口在程序退出后停住，便于看输出。
      // TERMCORE_HELLO_HOLD=1 让示例在 alt screen 里等一次按键再 leave。
      "args": [
        "--size", "80,25",
        "--pos", "200,200",
        "--title", "TermCore hello",
        "-d", "${workspaceFolder}",
        "cmd", "/k",
        "set TERMCORE_HELLO_HOLD=1 && \"${workspaceFolder}\\build\\windows-clang\\bin\\termcore_hello.exe\" & echo [exit=%ERRORLEVEL%] & pause"
      ],
      // 切换 windows-clang-release / windows-msvc 预设时改上面那个路径。
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["build: hello"],
      "presentation": { "reveal": "silent", "focus": false, "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
